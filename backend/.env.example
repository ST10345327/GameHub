# Copy this file to `.env` and fill in the values. NEVER commit `.env`.

PORT=3000
NODE_ENV=development

# Long random string used to sign login tokens (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# MySQL / MariaDB connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gamehub
# Set to true for hosted databases that require TLS (Aiven, TiDB Cloud, PlanetScale...)
DB_SSL=false

# IGDB uses Twitch OAuth. Create an application at https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=